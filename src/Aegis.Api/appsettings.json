{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=aegis;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "your-super-secret-key-minimum-32-characters-long-for-jwt-tokens!",
    "Issuer": "aegis-api",
    "Audience": "aegis-client",
    "ExpiryMinutes": "1440"
  },
  "AllowedHosts": "*"
}
